rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /publicBusinesses/{businessId} {
      allow read: if resource.data.published == true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
    }
    match /siteConfig/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }
    match /publicRequests/{requestId} {
      allow create: if request.resource.data.businessId is string
        && request.resource.data.type in ['consulta', 'reserva', 'presupuesto']
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.detail is string
        && request.resource.data.createdAt is string
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId == get(/databases/$(database)/documents/publicBusinesses/$(request.resource.data.businessId)).data.ownerId;
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
